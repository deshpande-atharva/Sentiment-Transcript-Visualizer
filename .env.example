# Copy to .env before running `docker compose up --build`.
# Compose reads this file automatically; never commit the populated .env.
#
# For non-Docker local development the existing per-service files are still used:
#   backend/.env   -> ANTHROPIC_API_KEY
#   frontend/.env  -> REACT_APP_DEEPGRAM_API_KEY, REACT_APP_BACKEND_URL

# --- backend (runtime) ---
# Sentiment/emotion/keyword extraction via the Anthropic Messages API.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- frontend (build time) ---
# Create React App inlines REACT_APP_* into the JS bundle at build time, so this
# key is readable by anyone who loads the page. Use a restricted/rotatable key.
REACT_APP_DEEPGRAM_API_KEY=your_deepgram_key_here

# Origin the browser uses to reach the backend. Must match the backend's CORS
# allow-list in backend/main.py.
REACT_APP_BACKEND_URL=http://localhost:8000
